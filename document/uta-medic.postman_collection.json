    {
      "name": "Doctor AI - Analyze Patient",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-doctor-user-id",
            "value": "{{doctorUserId}}",
            "description": "Solo para pruebas locales con DEV_AUTH_DOCTOR_HEADER_ENABLED=true. Debe ser Doctors.user_id."
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"question\": \"Resume el caso clinico y dame posibles diagnosticos diferenciales.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/doctor-ai/analyze",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "doctor-ai",
            "analyze"
          ]
        },
        "description": "Analiza un paciente asignado. Usa patientId obtenido de Doctor AI - List My Patients."
      },
      "response": []
    },
    {
      "name": "Doctor AI - Analyze Patient - Invalid Body",
