      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/doctor-ai/patients",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "doctor-ai",
            "patients"
