        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-doctor-user-id",
            "value": "{{doctorUserId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patientId\": \"no-es-uuid\",\n  \"question\": \"ok\"\n}"
