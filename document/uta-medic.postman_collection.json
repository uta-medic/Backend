    {
      "name": "Doctor AI - List My Patients",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-doctor-user-id",
            "value": "{{doctorUserId}}",
            "description": "Solo para pruebas locales con DEV_AUTH_DOCTOR_HEADER_ENABLED=true. Debe ser Doctors.user_id."
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/doctor-ai/patients",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "doctor-ai",
            "patients"
          ]
        },
        "description": "Lista pacientes activos asignados al medico. Copia patientId para probar /doctor-ai/analyze."
      },
      "response": []
    },
    {
